generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/3dhub.db"
}

model Filament {
  id            Int      @id @default(autoincrement())
  brand         String
  material      String   // PLA, PETG, ABS, TPU, etc.
  color         String
  colorHex      String?
  initialWeight Int      // grams
  currentWeight Int      // grams
  spoolWeight   Int      @default(200) // weight of empty spool in grams
  pricePerKg    Float?   // cost in local currency per kg
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  printJobs PrintJob[]
}

model PrintJob {
  id               Int       @id @default(autoincrement())
  bambuJobId       String?   // job id from printer
  fileName         String
  status           String    // completed, failed, cancelled
  filamentUsedGrams Int?     // grams consumed
  durationSeconds  Int?      // print time in seconds
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())

  pendingDeduction String?  // JSON: [{colorHex, grams, filamentId, filamentLabel}]

  filamentId Int?
  filament   Filament? @relation(fields: [filamentId], references: [id])
  issues     Issue[]
}

model Issue {
  id          Int       @id @default(autoincrement())
  type        String    // hms (from printer) | manual
  severity    String    // error | warning | info
  code        String?   // HMS code e.g. "0700_1000_0001_0001"
  title       String
  description String?
  status      String    @default("open") // open | tracking | resolved
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  printJobId  Int?
  printJob    PrintJob? @relation(fields: [printJobId], references: [id])
}

model PrinterConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ModelTag {
  id        Int      @id @default(autoincrement())
  fileName  String
  tag       String
  createdAt DateTime @default(now())

  @@unique([fileName, tag])
}

model PrinterProfile {
  id             Int      @id @default(autoincrement())
  name           String
  wattage        Float    @default(65)    // real watts consumption
  kwHPrice       Float    @default(0)     // price per kWh in local currency
  lifeHours      Int      @default(5000)  // printer expected life in hours
  partsPrice     Float    @default(0)     // replacement parts cost
  errorMarginPct Float    @default(15)    // error margin percentage
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotes ProductQuote[]
}

model ProductQuote {
  id        Int      @id @default(autoincrement())
  name      String

  // Model files (optional, JSON array of .3mf filenames)
  modelFiles String?

  // Filaments snapshot: [{filamentId?, label, pricePerKg, grams}]
  filamentsData String @default("[]")

  // Print time
  printHours   Float @default(0)
  printMinutes Float @default(0)

  // Printer config (snapshot at save time)
  printerProfileId Int?
  printerProfile   PrinterProfile? @relation(fields: [printerProfileId], references: [id])
  wattage          Float @default(65)
  kwHPrice         Float @default(0)
  lifeHours        Int   @default(5000)
  partsPrice       Float @default(0)
  errorMarginPct   Float @default(15)

  // External materials: [{name, price}]
  externalMaterials String @default("[]")

  // Fixed costs (design, post-processing, etc.)
  fixedCosts Float @default(0)

  // Profit
  profitMode  String @default("multiplier") // multiplier | percentage
  profitValue Float  @default(4)

  // Sale commission
  commissionPct Float @default(0)

  // Computed results (snapshot)
  productionCost   Float?
  totalCost        Float?
  salePrice        Float?
  salePriceWithFee Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
